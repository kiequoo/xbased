// xbased.exe's icon and version information.
#include <winver.h>

1 ICON "xbased.ico"

// UTF-8 as the process code page: the paths SDL hands out (the exe's folder,
// the games' folders) are UTF-8, and the CRT's open, fopen and mkdir take them
// as they are. With the ANSI one, a folder with an accent or a letter outside
// it (a user name with an n tilde) was another folder: the hdd went there or
// nowhere, and a game writing its cache showed its disc error.
1 24 "xbased.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,28,0
PRODUCTVERSION 1,0,28,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "crazyriddler"
            VALUE "FileDescription", "xbased - original Xbox emulator by crazyriddler"
            VALUE "FileVersion", "1.0.28"
            VALUE "InternalName", "xbased"
            VALUE "OriginalFilename", "xbased.exe"
            VALUE "ProductName", "xbased"
            VALUE "ProductVersion", "1.0.28"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
